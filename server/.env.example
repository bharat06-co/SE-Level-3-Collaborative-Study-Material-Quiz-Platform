NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/team1_study_dev?replicaSet=rs0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
JWT_ACCESS_TTL=15m
STORAGE_DIR=data/uploads

# Gmail SMTP - use a Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-test-sender@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-test-sender@gmail.com

# Frontend reset-password page
PASSWORD_RESET_URL=http://127.0.0.1:5173/reset-password