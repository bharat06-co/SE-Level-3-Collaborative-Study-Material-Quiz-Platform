# SEC-005: TLS terminates at the public web gateway. The API/MongoDB stay private.
# This file is rendered by the official nginx Docker entrypoint with
# SEC005_HTTPS_PORT (all nginx variables such as $host remain untouched).
server {
    listen 80;
    server_name _;
    server_tokens off;
    return 308 https://$host:${SEC005_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 21m;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Do not enable preload/includeSubDomains without explicit domain review.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
