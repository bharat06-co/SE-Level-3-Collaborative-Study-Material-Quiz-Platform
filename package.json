{
  "name": "team1-study-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspace client",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "smoke": "node scripts/check-running-app.cjs",
    "nfr004:session": "node scripts/nfr004-session.cjs",
    "nfr004:session:verify": "node scripts/nfr004-session.cjs --verify",
    "nfr004:validation": "node scripts/nfr004-browser-acceptance.cjs",
    "audit:runtime": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0"
  }
}
